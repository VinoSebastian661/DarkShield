{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/auth.js",
      "use": "@vercel/node"
    },
    {
      "src": "ml.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/ml.js"
    },
    {
      "src": "/v1/ml",
      "dest": "/api/auth.js"
    },
    {
      "src": "/(.*)",
      "dest": "/index.js"
    }
  ]
}